            def consume_under_year_day: () -> bool
            def consume_meridiem: (bool upper) -> bool
            def consume_zone: (Symbol token) -> bool
            def zero_zone: () -> bool
            def apply_offset: (String text, Hash[Symbol, untyped] shape) -> bool
            def consume_named_zone: () -> bool
            def named_zone_length: (String value) -> Integer
            def uppercase_run: (String value) -> Integer
            def gmt_length: (String value) -> Integer
            def signed_offset_length: (String rest) -> Integer
            def two_digits: (String text, Integer index) -> Integer?
            def consume_fraction: (untyped token) -> bool
            def fraction_fixed: (Integer digits) -> bool
            def fraction_optional: () -> bool
            def digit?: (String? char) -> bool
            def compose: () -> Integer?
