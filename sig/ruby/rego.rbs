          def self.scan_zed: (String layout, Integer index) -> Array[untyped]
          def self.scan_table: (String layout, Integer index, Array[[String, Symbol]] table) -> Array[untyped]
          def self.scan_fraction: (String layout, Integer index) -> Array[untyped]
          def self.emit: (Time time, untyped token) -> String
          def self.emit_field: (Time time, Symbol token) -> String?
          def self.zone_name: (Time time) -> String
          def self.zone_offset: (Time time, Symbol token) -> String
          def self.emit_fraction: (Time time, Array[untyped] frac) -> String
          def self.pad: (Integer value, Integer width) -> String
          def self.twelve_hour: (Integer hour) -> Integer

          ZONE_SHAPES: Hash[Symbol, Hash[Symbol, untyped]]

          def self.parse: (String layout, String value) -> Integer?

          # Go time.Parse port: one instance per parse, accumulating broken-down fields.
          class Parser
            SHORT_MONTHS: Array[String]
            SHORT_WEEKDAYS: Array[String]

            @layout: String
            @value: String
            @year: Integer
            @month: Integer
            @day: Integer
            @yday: Integer
            @hour: Integer
            @min: Integer
            @sec: Integer
            @nsec: Integer
            @zone_offset: Integer?
