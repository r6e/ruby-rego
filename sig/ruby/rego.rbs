            private

            def walk: () -> bool
            def skip_prefix: (String prefix) -> bool
            def consume: (untyped token) -> bool?
            def dispatch: (Symbol token) -> bool?
            def getnum: (bool fixed) -> Integer?
            def getnum3: (bool fixed) -> Integer?
            def getnum4: () -> Integer?
            def lookup: (Array[String] names) -> Integer?
            def consume_year2: () -> bool
