        # Builds the OPA JSON hash for one parsed certificate (json.Marshal of x509.Certificate +
        # URIStrings). Methods take/return untyped because they walk OpenSSL ASN.1/cert objects.
        module CertificateStruct
          SIGNATURE_ALGORITHMS: Hash[String, Integer]
          SUPPORTED_EC_CURVES: Array[String]
          RSA_PSS_NAME: String
          PSS_DIGEST_ALGORITHMS: Hash[String, Integer]
          PUBLIC_KEY_ALGORITHM_OIDS: Hash[String, Integer]
          ZERO_FIELDS: Hash[String, untyped]
          EXT_KEY_USAGES: Hash[String, Integer]
          NAME_CONSTRAINT_FIELDS: Hash[Integer, Array[String]]
          ACCESS_METHODS: Hash[String, String]
          RECOGNIZED_EXTENSION_OIDS: Array[String]
          EXTENSION_REQUEST_OID: String
          REQUEST_ZERO_FIELDS: Hash[String, untyped]
          MAX_ASN1_DEPTH: Integer
          INT64_MIN: Integer
          INT64_MAX: Integer

          def self.build: (untyped cert) -> Hash[String, untyped]
          def self.scrub: (untyped value) -> untyped
          def self.serial_number: (untyped cert) -> Integer
          def self.public_key: (untyped cert) -> untyped
          def self.oid_ints: (String oid) -> Array[Integer]
          def self.uri_fields: (Array[String] uri_texts) -> Hash[String, untyped]
          def self.apply_extensions: (Hash[String, untyped] fields, untyped cert) -> Hash[String, untyped]
          def self.build_request: (untyped request) -> Hash[String, untyped]
          def self.transcode: (String bytes, Encoding encoding) -> String
          def self.safe_asn1?: (String der) -> bool

          private

          def self.scalar_fields: (untyped cert, untyped decoded) -> Hash[String, untyped]
          def self.signature_algorithm: (untyped cert, untyped decoded) -> Integer
          def self.raw_fields: (untyped cert, untyped tbs, untyped issuer, untyped subject, untyped spki) -> Hash[String, untyped]
          def self.extension_nodes: (untyped tbs) -> untyped
          def self.extension_list: (untyped tbs) -> Array[untyped]?
          def self.extension_critical_value: (untyped ext) -> [ bool, untyped ]
          def self.extension_entry: (untyped ext) -> Hash[String, untyped]
          def self.request_extension_nodes: (untyped attributes) -> untyped
          def self.extension_request_extensions: (untyped attr) -> Array[untyped]
          def self.request_sans: (Hash[String, untyped] fields, untyped nodes) -> void
          def self.request_attributes: (untyped attributes) -> Array[untyped]?
          def self.attribute_set: (untyped attr) -> Hash[String, untyped]?
          def self.attribute_group: (untyped group) -> Array[untyped]
          def self.attribute_value: (untyped node) -> untyped
          def self.attribute_integer: (untyped big_number) -> Integer
          def self.parsed_uris: (Array[String] uri_texts) -> Array[untyped]
          def self.rfc3339: (untyped time) -> String
          def self.b64: (String bytes) -> String
          def self.ec_public_key: (untyped key) -> Hash[String, untyped]
          def self.url_struct: (untyped components) -> Hash[String, untyped]
          def self.certificate_extensions: (untyped cert) -> Array[untyped]
          def self.dispatch_extension: (Hash[String, untyped] fields, String oid, bool critical, String der) -> void
          def self.subject_key_id: (String der) -> String
          def self.authority_key_id: (String der) -> String?
          def self.key_usage: (String der) -> Integer
          def self.ext_key_usage: (Hash[String, untyped] fields, String der) -> void
          def self.basic_constraints: (Hash[String, untyped] fields, String der) -> void
          def self.subject_alt_name: (Hash[String, untyped] fields, String der) -> void
          def self.general_names: (String der) -> [ Array[String], Array[String], Array[String], Array[String] ]
          def self.authority_info_access: (Hash[String, untyped] fields, String der) -> void
          def self.name_constraints: (Hash[String, untyped] fields, String der, bool critical) -> void
          def self.add_constraint: (Hash[String, untyped] fields, untyped base, Integer column) -> void
